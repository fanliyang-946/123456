# ============================================================
# 知言 · 课堂英语口语对话智能体 —— 模型配置
# ============================================================
# 当前配置：硅基流动 SiliconFlow + Qwen3.5-4B
# 已实测可用（2026-10-08）。换服务商时改这三行即可，代码不用动。

LLM_API_KEY=sk-eonuqikmsziauaqvuxylbpmlfiplszbtmkesfvvduhaebrqt
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=Qwen/Qwen3.5-4B

# ------------------------------------------------------------
# 想换别的模型/服务商？把上面三行注释掉，换成下面任意一组。
# ------------------------------------------------------------

# ---------- DeepSeek（国内直连、便宜）----------
# LLM_API_KEY=sk-你的key
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-v4-flash      # 或 deepseek-v4-pro
# ⚠ 别写 deepseek-chat，已于 2026/07/24 停用

# ---------- 通义千问（阿里云官方）----------
# LLM_API_KEY=sk-你的key
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# ---------- 智谱 / Kimi ----------
# LLM_API_KEY=你的key
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-flash

# ---------- 课堂场景可调参数 ----------
# 小学生等不了太久 —— 网络慢可调小 LLM_TIMEOUT 到 12
# 想要 AI 更会追问更活泼 —— LLM_TEMPERATURE 调高到 0.9
# LLM_TEMPERATURE=0.8
# LLM_MAX_TOKENS=600
# LLM_TIMEOUT=20
