# ============================================================
# 知言· 课堂英语口语对话智能体 —— 模型配置示例
#============================================================
# 用法：把本文件复制成 .env（同一目录），把 key 填进去，重启服务即可。
#   复制：copy .env.example .env
# 填完 key 后，页面顶部会从「演示模式」变成「真模型」——
# 那个指示灯骗不了人，它读的就是这里的配置。
#
# ★ 没配 key 也能打开、能对话，只是走本地剧本，不会真的听懂学生说什么。
#   界面会如实标成「演示模式」，不会假装是真模型。
# ----------------------------------------------------------

# ---------- 一、DeepSeek（推荐：国内直连、最便宜） ----------
# 1. 打开 https://platform.deepseek.com 登录
# 2. 左侧 API Keys -> 新建 -> 复制保存（只显示一次）
# 3. 充值（课堂演示用量很小，几块钱够跑一学期）

LLM_API_KEY=sk-在这里粘贴你的key
LLM_BASE_URL=https://api.deepseek.com/v1

# ★ 模型名别写错，这几个是最常用的：
#   deepseek-v4-flash  快、便宜 —— 课堂对话首选，默认用这个
#   deepseek-v4-pro    能力强 —— 高中段/ 教研类任务用
#   deepseek-chat      已于 2026/07/24 废弃，写了会报「模型不存在」
LLM_MODEL=deepseek-v4-flash


# ---------- 二、通义千问（备选） ----------
# 换成下面三行、并把上面三行注释掉即可：
# LLM_API_KEY=sk-你的通义key
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# ---------- 三、智谱 / Kimi（月之暗面）----------
# LLM_API_KEY=你的key
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-flash

# LLM_API_KEY=你的key
# LLM_BASE_URL=https://api.moonshot.cn/v1
# LLM_MODEL=moonshot-v1-8k


# ---------- 四、可选：调参数 ----------
# 课堂场景建议：
#   小学生等不了久 —— 保持默认 timeout=20 秒；网络慢可以调小到 12
#   想要回复更稳、更保守 —— temperature 调低到 0.6
#   想要 AI 更会追问、更活泼 —— temperature 调高到 0.9
# LLM_TEMPERATURE=0.8
# LLM_MAX_TOKENS=600
